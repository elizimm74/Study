# Copy these lines into .env.local (that file is never uploaded to GitHub).

# Your Anthropic key (secret!)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase "crawler" project: accounts + saved tests.
# These two are PUBLIC by design (every visitor's browser gets them);
# the database's Row Level Security keeps each user's tests private.
NEXT_PUBLIC_SUPABASE_URL=https://txoimqedwfsuxoqiguop.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Qx4jian5THX3pU0Ocizymw_0NC4X9yo

# Your email: never hits the free-test limit (so you can keep testing).
ADMIN_EMAILS=you@example.com

# Free tests per account (the Free plan).
FREE_TESTS_PER_ACCOUNT=1
