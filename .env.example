# Copy this file to .env.local and fill in the blanks. .env.local is never uploaded.
# In production, set the same names as environment variables on each host.

# ---------- both web (Vercel) and worker ----------
# Supabase "crawler" project. These two are PUBLIC by design; Row Level
# Security in the database keeps each user's data private.
NEXT_PUBLIC_SUPABASE_URL=https://txoimqedwfsuxoqiguop.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Qx4jian5THX3pU0Ocizymw_0NC4X9yo

# The public address of the website (used for share links and social cards),
# e.g. https://crawler.app . On your own computer you can leave it out.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET. Also needed on the WEB app: the "Ask about this test" chat answers
# from the web server. console.anthropic.com
# (Put the same key on the worker too, see below.)
# ANTHROPIC_API_KEY=

# SECRET. Encrypts test-account logins while they wait in the queue.
# Make one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use the SAME value on the web app and the worker.
CREDENTIALS_KEY=

# ---------- worker only (NEVER put these on Vercel) ----------
# SECRET. Supabase dashboard -> Project Settings -> API Keys -> Secret keys.
SUPABASE_SECRET_KEY=
# SECRET. console.anthropic.com
ANTHROPIC_API_KEY=
# How many jobs one worker runs at the same time.
WORKER_CONCURRENCY=2
