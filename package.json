{
  "name": "study",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bench": "tsc -p tsconfig.bench.json && node scripts/crawler-bench.cjs && node scripts/explorer-bench.cjs",
    "realcheck": "tsc -p tsconfig.bench.json && node scripts/real-sites.cjs",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker": "node .worker-build/worker/main.js",
    "worker:dev": "npm run worker:build && node --env-file=.env.local .worker-build/worker/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "15.5.28",
    "playwright": "^1.63.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.6"
  }
}
